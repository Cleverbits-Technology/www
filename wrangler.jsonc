{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www-cleverbits",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "cleverbits.com.au",
      "custom_domain": true,
    },
    {
      "pattern": "www.cleverbits.com.au",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
